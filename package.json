{
  "name": "mandi-erp",
  "version": "0.0.0",
  "private": true,
  "description": "Mandi ERP (working name, AR-2): offline-first ERP for general trading companies working in mandi",
  "type": "module",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=11.21.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "secret-scan": "node tools/secret-scan/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=high",
    "sbom": "node tools/ci/sbom.mjs",
    "check": "node tools/ci/check.mjs",
    "check:offline": "node tools/ci/check.mjs --offline",
    "proof:bc01": "node tools/ci/proof-bc01.mjs",
    "mutation:numeric": "stryker run stryker.numeric.config.mjs",
    "mutation:summary": "node tools/ci/mutation-summary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@typescript-eslint/utils": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
